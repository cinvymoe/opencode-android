--- /dev/null
+++ b/packages/app/src/android-back-handler.tsx
@@ -0,0 +1,33 @@
+import { onCleanup, onMount } from "solid-js"
+import { useLocation } from "@solidjs/router"
+import { usePlatform } from "@/runtime/platform/platform"
+
+/**
+ * Handles the Android hardware back button.
+ * - In any sub-route: browser back
+ * - On home screen: return false so the platform exits the app (App.exitApp)
+ */
+export function AndroidBackHandler() {
+  const platform = usePlatform()
+  const location = useLocation()
+
+  onMount(() => {
+    if (platform.platform !== "android") return
+    if (!platform.onBackPressed) return
+
+    const cleanup = platform.onBackPressed(() => {
+      const path = location.pathname
+
+      // On home screen — return false so the platform exits the app (App.exitApp)
+      if (path === "/") return false
+
+      // In any sub-route — browser back
+      window.history.back()
+      return true
+    })
+
+    onCleanup(cleanup)
+  })
+
+  return null
+}
diff --git a/packages/app/src/android-status-bar.tsx b/packages/app/src/android-status-bar.tsx
new file mode 100644
