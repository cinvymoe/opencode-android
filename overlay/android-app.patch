--- /dev/null
+++ b/packages/app/src/android-status-bar.tsx
@@ -0,0 +1,20 @@
+import { createEffect } from "solid-js"
+import { useTheme } from "@opencode/ui/theme/context"
+import { usePlatform } from "@/runtime/platform/platform"
+
+/**
+ * Syncs the Android status bar style with the resolved color scheme.
+ * v2 has no per-platform theme effect; the desktop window theme is owned elsewhere.
+ */
+export function AndroidStatusBar() {
+  const platform = usePlatform()
+  const theme = useTheme()
+
+  createEffect(() => {
+    if (platform.platform !== "android") return
+    if (!platform.setStatusBarStyle) return
+    void platform.setStatusBarStyle(theme.mode() === "dark" ? "dark" : "light")
+  })
+
+  return null
+}
