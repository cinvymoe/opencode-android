diff --git a/packages/app/src/runtime/platform/android.ts b/packages/app/src/runtime/platform/android.ts
new file mode 100644
index 0000000000..4f87cba8e2
--- /dev/null
+++ b/packages/app/src/runtime/platform/android.ts
@@ -0,0 +1,117 @@
+import { App } from "@capacitor/app"
+import { LocalNotifications } from "@capacitor/local-notifications"
+import { Preferences } from "@capacitor/preferences"
+import { Share } from "@capacitor/share"
+import { StatusBar, Style } from "@capacitor/status-bar"
+import { ServerConnection } from "@/runtime/server/registry"
+import type { Platform } from "./platform"
+
+const DEFAULT_SERVER_KEY = "opencode.android.defaultServer"
+const SERVER_PASSWORD_KEY = "opencode.android.defaultServerPassword"
+// Mirrors foreground state so the native SSE watcher can suppress duplicate
+// notifications while the app is visible (the web layer owns that case).
+const NOTIFICATION_MUTED_KEY = "opencode.android.notifications.muted"
+
+const setNotificationMuted = (muted: boolean) =>
+  Preferences.set({ key: NOTIFICATION_MUTED_KEY, value: muted ? "1" : "0" }).catch(() => {})
+
+const watchNotificationMuted = () => {
+  if (typeof document === "undefined") return
+  const update = () => void setNotificationMuted(document.visibilityState === "visible")
+  document.addEventListener("visibilitychange", update)
+  update()
+}
+
+// In-page click callbacks keyed by native notification id. They only survive
+// while this WebView lives: a cold-start tap launches the app through the OS
+// intent, but cannot restore the callback registered by the previous process,
+// so we intentionally settle for "tap opens the app" instead of replaying a
+// deep link (there is no durable payload to reconstruct one from).
+const notificationClicks = new Map<number, () => void>()
+let nextNotificationID = 1
+
+const inset = (prop: string) => {
+  const value = getComputedStyle(document.documentElement).getPropertyValue(prop)
+  return Number.parseFloat(value) || 0
+}
+
+export async function createAndroidPlatform(version: string): Promise<Platform> {
+  watchNotificationMuted()
+  void LocalNotifications.addListener("localNotificationActionPerformed", (notification) => {
+    const click = notificationClicks.get(notification.notification.id)
+    notificationClicks.delete(notification.notification.id)
+    window.focus()
+    click?.()
+  })
+
+  return {
+    platform: "android",
+    version,
+
+    openExternal(url) {
+      if (!URL.canParse(url)) return
+      window.open(url, "_blank", "noopener,noreferrer")
+    },
+
+    restart: async () => window.location.reload(),
+
+    // Android WebView has no Notification constructor, so this must go through
+    // the native LocalNotifications plugin (schedule, not notify: 8.x API).
+    async notify(title, description, onClick) {
+      if (document.visibilityState === "visible" && document.hasFocus()) return
+      const permission = await LocalNotifications.requestPermissions().catch(() => ({ display: "denied" as const }))
+      if (permission.display !== "granted") return
+      const id = nextNotificationID++
+      if (onClick) notificationClicks.set(id, onClick)
+      await LocalNotifications.schedule({
+        notifications: [{ id, title, body: description ?? "", channelId: "opencode_alerts" }],
+      }).catch(() => {
+        notificationClicks.delete(id)
+      })
+    },
+
+    async getDefaultServer() {
+      const { value } = await Preferences.get({ key: DEFAULT_SERVER_KEY })
+      return value ? ServerConnection.Key.make(value) : null
+    },
+
+    async setDefaultServer(url) {
+      if (url === null) {
+        await Preferences.remove({ key: DEFAULT_SERVER_KEY })
+        await Preferences.remove({ key: SERVER_PASSWORD_KEY })
+        return
+      }
+      await Preferences.set({ key: DEFAULT_SERVER_KEY, value: url })
+    },
+
+    async setServerPassword(password) {
+      await Preferences.set({ key: SERVER_PASSWORD_KEY, value: password })
+    },
+
+    async share(opts) {
+      await Share.share(opts)
+    },
+
+    onBackPressed(callback) {
+      const listener = App.addListener("backButton", () => {
+        if (!callback()) void App.exitApp()
+      })
+      return () => {
+        void listener.then((handle) => handle.remove())
+      }
+    },
+
+    getSafeAreaInsets() {
+      return {
+        top: inset("--safe-area-inset-top"),
+        bottom: inset("--safe-area-inset-bottom"),
+        left: inset("--safe-area-inset-left"),
+        right: inset("--safe-area-inset-right"),
+      }
+    },
+
+    async setStatusBarStyle(style) {
+      await StatusBar.setStyle({ style: style === "dark" ? Style.Dark : Style.Light })
+    },
+  }
+}
